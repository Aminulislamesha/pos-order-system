generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Location {
  id        String         @id @default(cuid())
  uid       String?        @unique
  name      String         @unique
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  inventory Inventory[]
  logs      InventoryLog[]
}

model Product {
  id        String         @id @default(cuid())
  type      String         @default("PRODUCT")
  name      String         @unique
  sku       String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  inventory Inventory[]
  logs      InventoryLog[]
  aliases   ProductAlias[]
}

model ProductAlias {
  id        String   @id @default(cuid())
  alias     String   @unique
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Inventory {
  id         String   @id @default(cuid())
  locationId String
  productId  String
  quantity   Int      @default(0)
  updatedAt  DateTime @updatedAt
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([locationId, productId])
  @@index([locationId])
  @@index([productId])
}

model InventoryLog {
  id         String   @id @default(cuid())
  locationId String
  productId  String
  action     String
  quantity   Int
  reason     String?
  createdAt  DateTime @default(now())
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@index([productId])
}

model BaseProduct {
  id         String   @id @default(cuid())
  name       String   @unique
  aliases    String[]
  colorOrder String[] @default([])
  sizeOrder  String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Color {
  id        String   @id @default(cuid())
  name      String   @unique
  aliases   String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Size {
  id        String   @id @default(cuid())
  name      String   @unique
  aliases   String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id                  String    @id @default(uuid())
  name                String
  phone               String    @unique
  total_orders        Int       @default(0)
  last_order_date     DateTime?
  last_follow_up_date DateTime?
  is_followed_up      Boolean   @default(false)
  profile_note        String?   @db.Text
  addresses           String[]  @default([])
  alternate_phones    String[]  @default([])
  orders              Order[]

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([phone])
  @@index([name])
  @@index([last_order_date])
}

model Order {
  id                     String            @id @default(uuid())
  invoice_id             String
  customer_id            String
  customer               Customer          @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  date                   DateTime
  address                String
  details                String?           @db.Text
  total_bill             Float             @default(0.0)
  delivery_charge        Float             @default(0.0)
  cod_amount             Float             @default(0.0)
  net_receivable         Float             @default(0.0)
  status                 String            @default("pending")
  tracking_code          String?
  consignment_id         String?
  steadfast_created_at   DateTime?
  delivery_date          DateTime?
  return_date            DateTime?
  return_status          String?
  cancellation_type      String?
  cancel_reason          String?           @db.Text
  requires_manual_review Boolean           @default(false)
  manual_review_status   String?
  returned_items         String?           @db.Text
  last_status_checked_at DateTime?
  tracking_history       TrackingHistory[]

  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([invoice_id])
  @@index([customer_id])
  @@index([status])
  @@index([date])
  @@index([consignment_id])
  @@index([requires_manual_review])
}

model TrackingHistory {
  id              String   @id @default(uuid())
  order_id        String
  order           Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  previous_status String?
  new_status      String
  message         String?  @db.Text
  timestamp       DateTime @default(now())

  @@index([order_id])
  @@index([timestamp])
}

model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model ProductCost {
  id                String    @id @default(uuid())
  base_product_name String
  cost              Float     @default(0.0)
  effective_from    DateTime?
  effective_to      DateTime?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([base_product_name])
}
